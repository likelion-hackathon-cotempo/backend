# 이 파일을 .env로 복사해서 실제 값을 채운다. .env는 절대 커밋하지 않는다.
#   cp .env.example .env
#
# 새로운 환경변수를 추가하면 이 파일도 함께 갱신할 것.

# --- DB ---
# docker-compose가 MySQL root 비밀번호와 앱 접속 비밀번호에 함께 사용한다.
DB_PASSWORD=

# --- 인증 ---
# 32바이트 이상. 생성: openssl rand -base64 48
JWT_SECRET=
# 밀리초. 생략 시 3600000(1시간)
JWT_ACCESS_TOKEN_EXPIRATION=3600000

# --- 외부 API ---
# 없으면 앱이 기동되지 않는다 (application.yaml에 기본값 없음)
OPENAI_API_KEY=

# --- CORS ---
# 프론트 배포 주소. 쉼표로 여러 개 지정 가능하고 * 와일드카드를 쓸 수 있다.
# 예: https://cultureland.vercel.app,https://cultureland-*.vercel.app
CORS_ALLOWED_ORIGINS=

# --- 배포 (docker-compose.prod.yaml 전용) ---
# 이미지를 받아올 Docker Hub 계정명
DOCKERHUB_USERNAME=
# 배포할 이미지 태그. 생략 시 latest
IMAGE_TAG=latest
